# Application Settings
APP_NAME=SocialFlow AI
ENVIRONMENT=development
PORT=8000

# LLM Configuration
# Option 1: Local fine-tuned model (no API key needed)
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Option 2: Groq API (free, fast)
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3: Google Gemini API (free)
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# Hindsight Vectorize AI Memory System Configuration
# Docs: https://hindsight.vectorize.io/ | Dashboard: https://platform.vectorize.io
# GitHub: https://github.com/vectorize-io/hindsight
#
# Option A: Vectorize Cloud (Recommended for production):
# HINDSIGHT_URL=https://hindsight.vectorize.io
# HINDSIGHT_API_KEY=hsk_your_actual_vectorize_key_here
#
# Option B: Local Docker container (Self-hosted):
# Docker run: docker run -p 8888:8888 vectorizeio/hindsight:latest
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_API_KEY=hsk_demo_key_here
HINDSIGHT_BANK_ID=socialflow_user_bank

# Social Media API Tokens (Optional - for live data sync)
META_ACCESS_TOKEN=your_meta_access_token_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./socialflow.db

# Email & OTP SMTP Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAILS_FROM_EMAIL=noreply@socialflow.ai
EMAILS_FROM_NAME="SocialFlow AI Security"
